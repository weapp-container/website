<view class="app {{sideNavigation ? 'app-side' : ''}}" style="width:{{width}}px;height:{{height}}px">
  <view class="topbar" style="left:{{barX}}px;top:{{barY}}px;width:{{barWidth}}px;height:{{topbarHeight}}px">
    <view class="top-left" bindtap="back"><text wx:if="{{!sideNavigation}}" class="brand-mark">{{screen === 'home' || screen === 'shop' || screen === 'food' || screen === 'orders' ? 'W' : '‹'}}</text><text class="top-title">{{title}}</text></view>
    <view class="top-status {{feedback ? 'top-status-feedback' : ''}}"><view class="live-dot"></view><text class="top-status-text">{{statusLabel}}</text></view>
    <view wx:if="{{!sideNavigation}}" class="close-button" bindtap="close"><text>×</text></view>
  </view>
  <scroll-view class="body" scroll-y="true" style="left:{{bodyX}}px;top:{{bodyY}}px;width:{{bodyWidth}}px;height:{{contentHeight}}px" scroll-top="0">
    <view class="content">
      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'home'}}">
        <text class="eyebrow">ONE APP. EVERY SURFACE.</text>
        <text class="hero-title">小程序，<text class="accent">不止一端。</text></text>
        <text class="hero-copy">同一份业务，真实运行在 Web 与原生容器里。现在，亲手体验一下。</text>
        <view class="hero-panel"><view class="panel-top"><text class="panel-kicker">WEAPP CONTAINER</text><text class="tiny-tag">PREVIEW</text></view><text class="panel-title">一次构建，随处运行</text><view class="platforms"><text>Web</text><text>iOS</text><text>Android</text><text>HarmonyOS</text></view><view class="panel-rule"></view><view class="panel-bottom"><text>macOS · Windows · Linux</text><text class="panel-arrow">↗</text></view></view>
        <view class="section-head"><text class="section-title">从一个场景开始</text><text class="subtle">本地模拟 · 放心体验</text></view>
        <view class="scene-card" bindtap="openShop"><image class="scene-image" src="/assets/bottle.jpg" mode="aspectFill"/><view class="scene-text"><text class="scene-kicker">01 / LIFESTYLE</text><text class="scene-title">MORROW 商店</text><text class="secondary">搜索、选购到模拟下单</text></view><text class="arrow">›</text></view>
        <view class="scene-card" bindtap="openFood"><image class="scene-image" src="/assets/coffee.jpg" mode="aspectFill"/><view class="scene-text"><text class="scene-kicker">02 / DAILY FUEL</text><text class="scene-title">日日食堂</text><text class="secondary">一杯咖啡，一份轻食</text></view><text class="arrow">›</text></view>
        <view class="section-head"><text class="section-title">基础能力</text><text class="subtle">{{metrics}}</text></view>
        <view class="feature-grid"><view class="feature"><text class="feature-number">{{counter}}</text><text class="secondary">响应式更新</text><view class="small-button" bindtap="count">点击 +1</view></view><view class="feature"><text class="feature-number">{{orderCount}}</text><text class="secondary">本地模拟订单</text><view class="small-button" data-screen="orders" bindtap="navigate">查看记录</view></view></view>
        <view class="white-box"><text class="section-title">文字与动画</text><view class="field" bindtap="basicText"><text class="field-label">宿主输入</text><text class="field-value">{{basicValue || '点这里试试中文输入'}}</text><text class="arrow">›</text></view><view class="motion-track"><view class="motion-dot" style="left:{{motionOffset}}px"></view></view><view class="small-button" bindtap="animate">{{motionRunning ? '播放中…' : '播放简单动画'}}</view><text class="secondary">离开页面后自动停止</text></view>
        <view class="note-box"><text class="note-title">你看到的是正在运行的小程序</text><text class="secondary">页面、图片、滚动与业务状态由容器执行。搜索和地址使用宿主原生输入桥；所有订单与支付均为模拟。</text></view>
        <view class="reset-link" bindtap="askReset">重置本地演示数据</view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'shop'}}">
        <text class="eyebrow">MORROW / DAILY ESSENTIALS</text><text class="page-title">把日常，过成喜欢的样子。</text><text class="page-copy">精选 4 件好物，给生活留一点轻盈。</text>
        <view class="search" bindtap="search"><text class="search-icon">搜</text><text class="search-text {{query ? 'search-filled' : ''}}">{{query || '搜索杯子、耳机、托特包…'}}</text><text class="search-end">搜索</text></view>
        <view wx:if="{{query}}" class="search-result"><text>“{{query}}” · {{products.length}} 件好物</text><text class="text-action" bindtap="clearSearch">清除</text></view>
        <view class="chips"><view class="chip {{category === '全部' ? 'chip-active' : ''}}" data-value="全部" bindtap="category">全部</view><view class="chip {{category === '生活' ? 'chip-active' : ''}}" data-value="生活" bindtap="category">生活</view><view class="chip {{category === '数码' ? 'chip-active' : ''}}" data-value="数码" bindtap="category">数码</view><view class="chip {{category === '出行' ? 'chip-active' : ''}}" data-value="出行" bindtap="category">出行</view></view>
        <view class="catalog-list {{wideLayout ? 'catalog-list-wide' : ''}}" style="width:{{catalogWidth}}px;margin-left:{{catalogShift}}px"><view wx:for="{{products}}" wx:key="id" class="product-card" style="width:{{item.layoutWidth}}px" data-id="{{item.id}}" data-kind="shop" bindtap="detail"><view class="product-art" style="background-color:{{item.color}}"><image class="product-image" src="{{item.image}}" mode="aspectFill"/><text class="product-tag">{{item.tag}}</text></view><view class="product-info"><view><text class="product-name">{{item.name}}</text><text class="product-caption">{{item.subtitle}}</text></view><view class="product-price-row"><text class="price">¥{{item.priceText}}</text><view class="round-add">+</view></view></view></view></view>
        <view wx:if="{{!products.length}}" class="empty"><text class="empty-symbol">搜</text><text class="empty-title">还没有找到这件好物</text><text class="secondary">试试“杯”“耳机”或切换分类。</text><view class="small-button" bindtap="clearSearch">重新发现</view></view>
        <view class="basket-bar" data-kind="shop" bindtap="openCart"><view><text class="basket-name">购物袋 · {{cartCount}} 件</text><text class="basket-total">¥{{cartTotal}}</text></view><view class="basket-cta">查看购物袋 →</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'food'}}">
        <view class="store-banner"><text class="eyebrow light">DAILY TABLE</text><text class="store-title">认真吃饭，快乐每天。</text><text class="store-subtitle">日日食堂 · 演示路店</text><view class="store-status"><view class="light-dot"></view><text>营业中</text><text class="store-distance">步行 5 分钟 · 模拟门店</text></view></view>
        <view class="chips"><view class="chip {{foodCategory === '全部' ? 'chip-active' : ''}}" data-value="全部" bindtap="foodCategory">全部菜单</view><view class="chip {{foodCategory === '咖啡' ? 'chip-active' : ''}}" data-value="咖啡" bindtap="foodCategory">咖啡</view><view class="chip {{foodCategory === '轻食' ? 'chip-active' : ''}}" data-value="轻食" bindtap="foodCategory">轻食</view><view class="chip {{foodCategory === '热食' ? 'chip-active' : ''}}" data-value="热食" bindtap="foodCategory">热食</view></view>
        <view class="catalog-list {{wideLayout ? 'catalog-list-wide' : ''}}" style="width:{{catalogWidth}}px;margin-left:{{catalogShift}}px"><view wx:for="{{meals}}" wx:key="id" class="meal-card" style="width:{{item.layoutWidth}}px" data-id="{{item.id}}" data-kind="food" bindtap="detail"><image class="meal-image" src="{{item.image}}" mode="aspectFill"/><view class="meal-info"><text class="meal-tag">{{item.tag}}</text><text class="meal-name">{{item.name}}</text><text class="meal-caption">{{item.subtitle}}</text><view class="meal-bottom"><text class="price">¥{{item.priceText}}</text><view class="meal-count"><text wx:if="{{item.quantity}}" class="subtle">已选 {{item.quantity}}</text><view class="round-add">+</view></view></view></view></view></view>
        <view class="note-box"><text class="note-title">从菜单到取餐，一次完整体验</text><text class="secondary">可以选择规格、填写备注，再模拟下单。不会向门店发送订单，也不会发生真实支付。</text></view>
        <view class="basket-bar" data-kind="food" bindtap="openCart"><view><text class="basket-name">餐袋 · {{foodCount}} 份</text><text class="basket-total">¥{{foodTotal}}</text></view><view class="basket-cta">选好了，去下单 →</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'product'}}">
        <view class="detail-art" style="background-color:{{detail.color}}"><image class="detail-image" src="{{detail.image}}" mode="aspectFill"/><text class="detail-tag">{{detail.tag}}</text></view>
        <view class="detail-heading"><view><text class="detail-name">{{detail.name}}</text><text class="product-caption">{{detail.subtitle}}</text></view><text class="detail-price">¥{{detail.priceText}}</text></view>
        <text class="description">{{detail.description}}</text>
        <view class="section-head"><text class="section-title">{{detailKind === 'food' ? '口味与规格' : '选择颜色'}}</text><text class="subtle">选一个喜欢的</text></view>
        <view class="specs"><view wx:for="{{detail.specOptions}}" wx:key="index" class="spec {{selectedSpec === item.index ? 'spec-active' : ''}}" data-index="{{item.index}}" bindtap="spec">{{item.label}}</view></view>
        <view class="quantity-row"><text class="section-title">数量</text><view class="quantity"><view class="quantity-button" data-delta="-1" bindtap="detailQuantity">−</view><text>{{detailQuantity}}</text><view class="quantity-button" data-delta="1" bindtap="detailQuantity">+</view></view></view>
        <view class="actions"><view class="button button-secondary" bindtap="addDetail">加入{{detailKind === 'food' ? '餐袋' : '购物袋'}}</view><view class="button button-primary" bindtap="buyDetail">{{detailKind === 'food' ? '去点单' : '立即选购'}} →</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'cart'}}">
        <text class="eyebrow">{{cartKind === 'food' ? 'YOUR DAILY FUEL' : 'YOUR SHOPPING BAG'}}</text><text class="page-title">{{cartKind === 'food' ? '今天，想吃点什么？' : '喜欢的，都在这里。'}}</text><text class="page-copy">{{checkoutCount}} {{cartKind === 'food' ? '份美味' : '件好物'}} · 随时调整，慢慢挑选</text>
        <view wx:for="{{cartLines}}" wx:key="key" class="cart-card"><image class="cart-image" src="{{item.image}}" mode="aspectFill"/><view class="cart-info"><text class="product-name">{{item.name}}</text><text class="secondary">{{item.specText}}</text><view class="cart-bottom"><text class="price">¥{{item.priceText}}</text><view class="quantity quantity-small"><view class="quantity-button" data-key="{{item.key}}" data-delta="-1" bindtap="changeQuantity">−</view><text>{{item.quantity}}</text><view class="quantity-button" data-key="{{item.key}}" data-delta="1" bindtap="changeQuantity">+</view></view></view></view></view>
        <view wx:if="{{!cartLines.length}}" class="empty"><text class="empty-symbol">＋</text><text class="empty-title">{{cartKind === 'food' ? '餐袋还是空的' : '购物袋还是空的'}}</text><text class="secondary">去发现一点今天的小快乐。</text><view class="button button-primary" bindtap="back">继续逛逛</view></view>
        <view wx:if="{{cartKind === 'food' && cartLines.length}}" class="white-box"><text class="section-title">取餐方式</text><view class="chips"><view class="chip {{pickup === '到店自取' ? 'chip-active' : ''}}" data-value="到店自取" bindtap="pickup">到店自取</view><view class="chip {{pickup === '店内用餐' ? 'chip-active' : ''}}" data-value="店内用餐" bindtap="pickup">店内用餐</view></view><view class="field" bindtap="note"><text class="field-label">订单备注</text><text class="field-value">{{note || '少糖、酱汁分装… 点击填写'}}</text><text class="arrow">›</text></view></view>
        <view wx:if="{{cartLines.length}}" class="summary"><view class="summary-line"><text>商品合计</text><text>¥{{checkoutTotal}}</text></view><view class="summary-line secondary"><text>{{cartKind === 'food' ? '服务费' : '配送费'}}</text><text>¥0.00</text></view><view class="summary-total"><text>合计</text><text>¥{{checkoutTotal}}</text></view><view class="button button-primary full" bindtap="checkout">确认{{cartKind === 'food' ? '点单' : '商品'}} →</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'checkout'}}">
        <text class="eyebrow">ONE MORE STEP</text><text class="page-title">{{cartKind === 'food' ? '美味，马上安排。' : '送到你身边。'}}</text><text class="page-copy">这是演示订单，不会收取任何费用。</text>
        <view wx:if="{{cartKind === 'shop'}}" class="white-box"><view class="section-head compact"><text class="section-title">收货信息</text><text class="subtle">点击编辑</text></view><view class="field" data-field="name" bindtap="address"><text class="field-label">收货人</text><text class="field-value">{{address.name || '请填写姓名'}}</text><text class="arrow">›</text></view><view class="field" data-field="phone" bindtap="address"><text class="field-label">联系电话</text><text class="field-value">{{address.phone || '请填写电话'}}</text><text class="arrow">›</text></view><view class="field address-field" data-field="detail" bindtap="address"><text class="field-label">收货地址</text><text class="field-value">{{address.detail || '请填写地址'}}</text><text class="arrow">›</text></view></view>
        <view wx:if="{{cartKind === 'food'}}" class="white-box"><text class="section-title">日日食堂 · 演示路店</text><text class="description">{{pickup}} · 预计 10–15 分钟（模拟）</text><view class="field" bindtap="note"><text class="field-label">订单备注</text><text class="field-value">{{note || '暂无备注，点击填写'}}</text><text class="arrow">›</text></view></view>
        <view class="white-box"><text class="section-title">{{cartKind === 'food' ? '你的餐点' : '商品清单'}}</text><view wx:for="{{cartLines}}" wx:key="key" class="checkout-line"><image class="checkout-image" src="{{item.image}}" mode="aspectFill"/><view class="checkout-name"><text class="product-name">{{item.name}}</text><text class="secondary">{{item.specText}} × {{item.quantity}}</text></view><text class="checkout-price">¥{{item.subtotalText}}</text></view></view>
        <view class="summary"><view class="summary-total"><text>应付金额</text><text>¥{{checkoutTotal}}</text></view><view class="simulation"><view class="simulation-dot"></view><text>模拟支付 · 不会产生真实交易</text></view><view class="button button-primary full" bindtap="askPay">模拟支付 ¥{{checkoutTotal}}</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'orders'}}">
        <text class="eyebrow">LITTLE MOMENTS, SAVED.</text><text class="page-title">每一份喜欢，都有记录。</text><text class="page-copy">演示订单保存在这台设备，随时可以重置。</text><view class="chips"><view class="chip {{orderFilter === 'all' ? 'chip-active' : ''}}" data-value="all" bindtap="orderFilter">全部订单</view><view class="chip {{orderFilter === 'shop' ? 'chip-active' : ''}}" data-value="shop" bindtap="orderFilter">商店</view><view class="chip {{orderFilter === 'food' ? 'chip-active' : ''}}" data-value="food" bindtap="orderFilter">点单</view></view>
        <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder"><view class="order-card-top"><text class="order-brand">{{item.kindText}}</text><text class="order-status status-{{item.status}}">{{item.statusText}}</text></view><view class="order-card-body"><image class="cart-image" src="{{item.image}}" mode="aspectFill"/><view class="order-card-info"><text class="product-name">{{item.name}}</text><text class="secondary">共 {{item.quantity}} 件 · {{item.id}}</text><text class="price">¥{{item.totalText}}</text></view><text class="arrow">›</text></view></view>
        <view wx:if="{{!orders.length}}" class="empty"><text class="empty-symbol">≡</text><text class="empty-title">你的第一份订单，正在路上</text><text class="secondary">去商店或食堂，完成一次模拟下单吧。</text><view class="button button-primary" bindtap="openShop">逛逛商店</view></view>
      </view>

      <view class="page-pane" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px" wx:if="{{screen === 'order' && order}}">
        <view class="success-panel"><text class="success-mark">{{order.status === 'cancelled' ? '−' : '✓'}}</text><text class="success-title">{{order.status === 'preparing' ? '好味道，正在准备。' : order.status === 'paid' ? '好物，即将出发。' : order.status === 'completed' ? '这份喜欢，已完成。' : '演示订单已取消。'}}</text><text class="success-copy">{{order.kindText}} · {{order.statusText}}</text><text class="simulation-label">模拟订单 · 无真实扣款</text></view>
        <view class="white-box"><text class="section-title">订单详情</text><view wx:for="{{order.details}}" wx:key="key" class="checkout-line"><image class="checkout-image" src="{{item.image}}" mode="aspectFill"/><view class="checkout-name"><text class="product-name">{{item.name}}</text><text class="secondary">{{item.specText}} × {{item.quantity}}</text></view><text class="checkout-price">¥{{item.subtotalText}}</text></view><view class="summary-total"><text>订单合计</text><text>¥{{order.totalText}}</text></view></view>
        <view class="white-box"><view class="info-line"><text class="secondary">订单编号</text><text>{{order.id}}</text></view><view class="info-line"><text class="secondary">配送 / 取餐</text><text>{{order.kind === 'food' ? order.pickup : '模拟快递配送'}}</text></view><view wx:if="{{order.kind === 'shop'}}" class="order-address"><text>{{order.address.name}} · {{order.address.phone}}</text><text class="secondary">{{order.address.detail}}</text></view><view wx:if="{{order.note}}" class="order-address"><text class="secondary">订单备注</text><text>{{order.note}}</text></view></view>
        <view wx:if="{{order.active}}" class="actions"><view class="button button-secondary" data-action="cancel" bindtap="transition">取消演示订单</view><view class="button button-primary" data-action="complete" bindtap="transition">模拟{{order.kind === 'food' ? '取餐' : '收货'}} ✓</view></view><view wx:else class="button button-primary full" bindtap="reorder">再来一单 →</view>
      </view>
      <text class="page-foot" style="width:{{contentPaneWidth}}px;margin-left:{{contentOffset}}px">WEAPP CONTAINER / SAME PACK, EVERYWHERE</text>
    </view>
  </scroll-view>
  <view wx:if="{{sideNavigation}}" class="rail-top" style="left:{{railX}}px;top:{{railY}}px;width:{{railWidth}}px"><view class="rail-close" style="height:{{railButtonHeight}}px" bindtap="close"><text>×</text></view><view class="rail-back" style="height:{{railButtonHeight}}px" bindtap="back"><text>{{screen === 'home' || screen === 'shop' || screen === 'food' || screen === 'orders' ? 'W' : '‹'}}</text></view></view>
  <view class="nav {{sideNavigation ? 'nav-rail' : ''}}" style="left:{{navX}}px;top:{{navY}}px;width:{{navWidth}}px;height:{{navLayoutHeight}}px"><view class="nav-item {{active === 'home' ? 'nav-active' : ''}}" data-screen="home" bindtap="navigate"><text class="nav-symbol">W</text><text>探索</text></view><view class="nav-item {{active === 'shop' ? 'nav-active' : ''}}" data-screen="shop" bindtap="navigate"><text class="nav-symbol">▢</text><text>商店</text></view><view class="nav-item {{active === 'food' ? 'nav-active' : ''}}" data-screen="food" bindtap="navigate"><text class="nav-symbol">食</text><text>点单</text></view><view class="nav-item {{active === 'orders' ? 'nav-active' : ''}}" data-screen="orders" bindtap="navigate"><text class="nav-symbol">≡</text><text>订单</text></view></view>
  <view wx:if="{{textPending}}" class="input-hint" style="left:{{hintX}}px;top:{{hintY}}px;width:{{hintWidth}}px"><text>请在宿主输入框完成编辑</text></view>
  <view wx:if="{{resetConfirm || confirmPay}}" class="modal-shade"><view class="modal" style="left:{{modalX}}px;top:{{modalY}}px;width:{{modalWidth}}px;height:{{modalHeight}}px"><scroll-view class="modal-body" scroll-y="true" style="height:{{modalBodyHeight}}px"><view class="modal-content"><text class="modal-kicker">{{resetConfirm ? 'START FRESH' : 'DEMO CHECKOUT'}}</text><text class="modal-title">{{resetConfirm ? '重新开始这次体验？' : '确认模拟支付？'}}</text><text class="modal-copy">{{resetConfirm ? '将清空购物袋、订单与输入信息，恢复默认演示数据。' : '这只是本地演示，不会连接支付平台，也不会发生真实扣款。'}}</text></view></scroll-view><view wx:if="{{resetConfirm}}" class="actions modal-actions" style="height:{{modalActionsHeight}}px"><view class="button button-secondary" style="height:{{modalButtonHeight}}px;line-height:{{modalButtonHeight}}px" bindtap="cancelReset">保留数据</view><view class="button button-primary" style="height:{{modalButtonHeight}}px;line-height:{{modalButtonHeight}}px" bindtap="reset">确认重置</view></view><view wx:else class="actions modal-actions" style="height:{{modalActionsHeight}}px"><view class="button button-secondary" style="height:{{modalButtonHeight}}px;line-height:{{modalButtonHeight}}px" bindtap="cancelPay">再看看</view><view class="button button-primary" style="height:{{modalButtonHeight}}px;line-height:{{modalButtonHeight}}px" bindtap="pay">模拟支付</view></view></view></view>
</view>
