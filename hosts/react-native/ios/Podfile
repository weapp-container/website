# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require 'shellwords'

platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HelloWorld' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Apply the application's supported OS baseline to resource bundle targets
    # as well. Older dependency podspecs otherwise emit unsupported iOS 13.4.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |configuration|
        if configuration.name == 'Release'
          flags = configuration.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          configuration.build_settings['OTHER_LDFLAGS'] = Array(flags) + ['-Wl,-S,-x']
          %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS].each do |key|
            flags = configuration.build_settings[key] || ['$(inherited)']
            flags = Shellwords.shellsplit(flags) if flags.is_a?(String)
            configuration.build_settings[key] = flags + ["-ffile-prefix-map=#{File.expand_path('../../..', __dir__)}=/showcase"]
          end
        end
        version = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if version && Gem::Version.new(version) < Gem::Version.new('16.0')
          configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        end
      end
    end
  end
end
