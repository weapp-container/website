/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

# Keep HTML inside the audited asset closure: Cloudflare Web Analytics honors
# no-transform and does not inject a cross-origin beacon. Binary assets retain
# normal edge compression. Matching Cache-Control values are comma-joined.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/demo/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/guide/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/platforms/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/docs/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/en/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/runtime/*
  Cache-Control: public, max-age=31536000, immutable

/runtime/*/
  Cache-Control: no-transform

/runtime/*/index.html
  Cache-Control: no-transform

/media/*
  Cache-Control: public, max-age=86400

/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/showcase-runtime.json
  Cache-Control: no-cache

/release-status.json
  Cache-Control: no-cache
