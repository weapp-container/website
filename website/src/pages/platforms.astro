---
import Layout from '../layouts/Layout.astro';
import status from '../../../platforms/status.json';
const labels: Record<string,string> = { passed: '已通过', pending: '待验证', blocked: '待条件就绪', 'not-run': '未执行', unsigned: '待签名', 'not-required': '不适用', 'emulator-verified': '模拟器已验证', 'simulator-verified': '模拟器已验证', 'device-verified': '真机已验证', 'desktop-verified': '桌面运行已验证', 'local-verified': '本机已验证', 'release-signed': 'Release 已签名', 'verified-release-key': 'Release 签名已验证', 'unsigned-simulator': '真机待签名', 'consumer-verified': '独立消费者已验证' };
---
<Layout title="全端进展 · Weapp Container">
  <section class="section-wrap page-intro"><p class="eyebrow">全端进展</p><h1>每个端，都有自己的验证。</h1><p>构建、安装和真实运行分别记录。只有通过对应验证的产物，才会开放给授权人员下载。</p></section>
  <section class="section-wrap status-section"><div class="status-table-wrap"><table><thead><tr><th>运行平台</th><th>构建</th><th>安装</th><th>运行</th><th>签名</th></tr></thead><tbody>{status.platforms.map(item => <tr><th><strong>{item.name}</strong><span>{item.architecture}</span></th><td>{labels[item.build] || item.build}</td><td>{labels[item.install] || item.install}</td><td>{labels[item.runtime] || item.runtime}</td><td>{labels[item.signing] || item.signing}</td></tr>)}</tbody></table></div><p class="table-caption">更新时间：{status.updatedAt}。编译通过不代表真机、性能或完整兼容性验收。</p><ul class="platform-notes">{status.platforms.filter(item => item.note).map(item => <li><strong>{item.name}：</strong>{item.note}</li>)}</ul></section>
  <section class="section-wrap integration-section"><h2>选择适合你的接入方式。</h2><div class="integration-list"><article><h3>原生 SDK</h3><p>Android、iOS 和 C++ Desktop 独立接入。</p></article><article><h3>Flutter</h3><p>Android、iOS、macOS、Windows 与 Linux。</p></article><article><h3>React Native</h3><p>Android 与 iOS 新架构消费样例。</p></article><article><h3>HarmonyOS</h3><p>ArkTS 宿主与受限运行库。</p></article></div><a class="button secondary" href="https://github.com/weapp-container/showcase/releases" target="_blank" rel="noreferrer">查看私有发行记录 ↗</a><p class="muted">需要仓库访问权限。公开网站不会下发下载凭据。</p></section>
</Layout>
<style>.platform-notes{margin:24px 0 0;padding-left:18px;color:var(--muted);font-size:12px;line-height:1.9}.platform-notes li+li{margin-top:8px}.platform-notes strong{font-weight:600;color:var(--text)}</style>
