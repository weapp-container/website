---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsPages } from '../../data/docs-pages.mjs';
const sections = [...new Set(docsPages.filter((page) => page.path !== '/docs/').map((page) => page.section))];
---
<DocsLayout title="开发文档" description="Weapp Container 宿主接入指南、SDK API 与小程序能力参考。">
  <header class="docs-page-heading"><p class="eyebrow">DEVELOPER DOCUMENTATION</p><h1>开发文档</h1><p>把小程序嵌入已有应用。准备包、选择 SDK、挂载并加载，保留自己的小程序开发工具和框架。</p></header>
  <section class="docs-start-strip" aria-label="快速入口"><a href="/docs/start/"><strong>快速开始</strong><span>用独立测试包完成首次接入</span></a><a href="/docs/integrations/"><strong>选择集成方式</strong><span>按应用框架安装 SDK</span></a><a href="/docs/api/"><strong>查阅 API</strong><span>按能力组查看接口和宿主覆盖</span></a></section>
  {sections.map((section) => <section class="docs-index-section"><h2>{section}</h2><ul class="docs-index-list">{docsPages.filter((page) => page.section === section).map((page) => <li><a href={page.path}><strong>{page.title}</strong><span>{page.summary}</span></a></li>)}</ul></section>)}
  <aside class="docs-callout docs-callout-note"><strong>预览版状态</strong><p>SDK 源码、运行库产物与各平台的构建/运行验证是不同状态。本文档按各自版本与证据标记，不代表所有 API 已在全部平台通过验证。</p></aside>
</DocsLayout>
