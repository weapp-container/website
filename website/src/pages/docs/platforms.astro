---
import DocsLayout from '../../layouts/DocsLayout.astro';
import status from '../../../../platforms/status.json';
const docs = {
  Web: '/docs/integrations/web/', Android: '/docs/integrations/android/', iOS: '/docs/integrations/ios/',
  HarmonyOS: '/docs/integrations/harmony/', macOS: '/docs/integrations/desktop/',
  Windows: '/docs/integrations/desktop/', Linux: '/docs/integrations/desktop/',
};
const labels: Record<string, string> = {
  passed: '已通过', pending: '待验证', blocked: '待条件就绪', 'not-run': '未执行', unsigned: '待签名',
  'not-required': '不适用', 'emulator-verified': '模拟器已验证', 'simulator-verified': '模拟器已验证',
  'device-verified': '真机已验证', 'desktop-verified': '桌面运行已验证', 'local-verified': '本机已验证',
  'release-signed': 'Release 已签名', 'verified-release-key': 'Release 签名已验证',
  'unsigned-simulator': '模拟器构建未签名', 'runner-bundle-verified': 'runner bundle 已验证',
  'consumer-verified': 'SDK consumer 已验证', 'unsigned-device': '设备包未签名', 'partial': '部分通过',
};
---
<DocsLayout title="平台状态与支持边界" description="Weapp Container 各端构建、安装、运行与签名矩阵。">
  <header class="docs-page-heading"><p class="eyebrow">PLATFORMS</p><h1>平台状态与支持边界</h1><p>构建、安装、运行和发布签名分别验证。这里只展示各自独立证据，不把一个阶段标记外推到另一阶段。</p></header>
  <section class="docs-index-section"><h2>当前平台矩阵</h2><div class="docs-table-scroll"><table class="docs-table docs-platform-table"><thead><tr><th scope="col">平台</th><th scope="col">架构</th><th scope="col">构建</th><th scope="col">安装</th><th scope="col">运行</th><th scope="col">签名</th></tr></thead><tbody>{status.platforms.map((platform) => <tr><th scope="row"><a href={docs[platform.name] || '/docs/integrations/'}>{platform.name}</a></th><td>{platform.architecture}</td><td>{labels[platform.build] || platform.build}</td><td>{labels[platform.install] || platform.install}</td><td>{labels[platform.runtime] || platform.runtime}</td><td>{labels[platform.signing] || platform.signing}</td></tr>)}</tbody></table></div><p class="docs-source-note">更新日期：{status.updatedAt}。下表来源仓库平台状态快照。示例代码支持情况以该快照 source commit 和各平台 receipt 为准。</p></section>
  <h2 id="limitations">重要限制</h2>
  <ul><li><strong>HarmonyOS：</strong> ArkTS Release HAP 构建已记录；安装和设备运行尚未记录。</li><li><strong>Windows：</strong> Desktop SDK consumer 证据不代表原生 Showcase app 已完整通过。</li><li><strong>Linux：</strong> runner 启动和画面记录不代表所有商城、文本交互或 Flutter ABI 全通过。</li><li><strong>iOS：</strong> Simulator 和真机属于不同证据；缺少 Apple 分发签名的候选不能直接外推到正式分发。</li><li><strong>移动端 ABI：</strong>构建容器、模拟器和 arm64 真机执行需逐目标核验，不假设架构完全对称。</li></ul>
  <h2 id="acceptance">每个目标应该如何验收</h2>
  <p>取得相符 artifact pin 后，在被测目标验证 archive/path/hash，之后单独编译独立consumer。应用安装后检查 native graphics surface、有效首帧、点击/滚动、路由、后台暂停/恢复、storage flush/重开和显式关闭。签名、公证、系统权限与实际设备型号需要额外标记。任何“passed”都应关联运行时版本、pack root 和不可变 receipt。</p>
  <p><a href="/platforms/">打开简版平台总览</a></p>
</DocsLayout>
