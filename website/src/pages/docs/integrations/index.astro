---
import DocsLayout from '../../../layouts/DocsLayout.astro';
const integrations = [
  ['Android', '/docs/integrations/android/', 'Kotlin Session 与 GLES View，Android API 26+。'],
  ['iOS', '/docs/integrations/ios/', 'Swift Concurrency、UIKit View，iOS 16.0+。'],
  ['C++ Desktop', '/docs/integrations/desktop/', 'C++17 Session，macOS、Windows 和 Linux。'],
  ['Flutter', '/docs/integrations/flutter/', 'weapp_container Controller 与 Widget，Android / iOS / macOS / Windows / Linux。'],
  ['React Native', '/docs/integrations/react-native/', 'Fabric Native View 与 TurboModule，React Native 0.88。'],
  ['Web 在线演示', '/docs/integrations/web/', '固定浏览器展示，不是通用应用嵌入 SDK。'],
  ['HarmonyOS 示例', '/docs/integrations/harmony/', 'ArkTS Showcase 和实际构建/运行状态。'],
];
---
<DocsLayout title="接入方式" description="Weapp Container 原生与跨平台集成方式和支持边界。">
  <header class="docs-page-heading"><p class="eyebrow">INTEGRATION</p><h1>接入方式</h1><p>按应用现有的语言或 UI 框架选择 SDK。各端使用同一种小程序包，无需更换小程序开发工具。</p></header>
  <section class="docs-index-section"><h2>SDK 与宿主</h2><ul class="docs-index-list">{integrations.map(([title, path, summary]) => <li><a href={path}><strong>{title}</strong><span>{summary}</span></a></li>)}</ul></section>
  <h2 id="common-steps">共通步骤</h2>
  <ol><li>按平台指南把 SDK 加到应用，并准备匹配的运行库。</li><li>把<a href="/docs/start/#prepare-source">测试包</a>或<a href="/docs/pack/#own-miniapp">自己打好的包</a>放进应用资源目录。</li><li>创建会话、挂载视图、调用 <code>load</code>。退出功能时等待存储写回和会话关闭。</li></ol>
  <aside class="docs-callout docs-callout-note"><strong>预览版发行说明</strong><p>SDK 包装层源码与预编译运行库有各自的版本、许可证和发行记录。使用归档时核对其版本锁和哈希；受限演示归档只允许指定包。详见<a href="/docs/licensing/">许可、下载与发行</a>。</p></aside>
  <p>适用平台和实测边界请继续阅读 <a href="/docs/platforms/">平台状态与支持边界</a>。</p>
</DocsLayout>
