---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import capabilities from '../../../data/api-default-capabilities-v1.json';
import source from '../../../data/api-source-v1.json';
const rows = Object.entries(capabilities).sort(([left], [right]) => left.localeCompare(right));
---
<DocsLayout title="运行时默认能力" description="manifest 能力默认值与尚无逐平台覆盖记录的 API。">
  <header class="docs-page-heading"><p class="eyebrow">API REFERENCE</p><h1>运行时默认能力</h1><p>默认能力来自 manifest 打包器的运行时默认配置。它描述默认 manifest 值，不代表所有宿主都实现、授权或通过了该能力。</p></header>
  <aside class="docs-callout docs-callout-warning"><strong>{source.coverageGaps.capabilityOnly.length} 项缺少逐平台状态</strong><p>这些接口出现在运行时默认能力表，但当前 API 目录没有对应的平台覆盖条目。站点不会根据默认值推断其 Web、移动端或桌面端状态。</p></aside>
  <section class="docs-index-section"><h2>尚无逐平台覆盖记录的能力</h2><ul class="docs-name-list">{source.coverageGaps.capabilityOnly.map((name: string) => <li><code>{name}</code><span class={`docs-support ${capabilities[name] === 'full' ? 'support-full' : 'support-partial'}`}>默认值：{capabilities[name]}</span></li>)}</ul></section>
  <section class="docs-index-section"><h2>全部默认值</h2><div class="docs-table-scroll"><table class="docs-table"><thead><tr><th scope="col">能力名称</th><th scope="col">默认等级</th></tr></thead><tbody>{rows.map(([name, value]) => <tr><th scope="row"><code>{name}</code></th><td>{value}</td></tr>)}</tbody></table></div></section>
  <p class="docs-source-note">快照来源提交 <code>{source.source.commit.slice(0, 12)}</code>，默认值规范化 SHA-256：<code>{source.capabilities.canonicalSha256}</code>。</p>
</DocsLayout>
