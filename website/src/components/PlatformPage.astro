---
import Layout from '../layouts/Layout.astro';
import status from '../../../platforms/status.json';
import {localeFromPath, localizedPath} from '../data/i18n.mjs';
import copy from '../data/platform-copy.json';

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === 'en';
const t = (value: string) => isEn ? copy[value.trim() as keyof typeof copy] || value : value;
const href = (value: string) => localizedPath(value, locale);
const labels: Record<string, string> = {
  passed: '已通过',
  pending: '待验证',
  blocked: '待条件就绪',
  'not-run': '未执行',
  unsigned: '待签名',
  'not-required': '不适用',
  'emulator-verified': '模拟器已验证',
  'simulator-verified': '模拟器已验证',
  'device-verified': '真机已验证',
  'desktop-verified': '桌面运行已验证',
  'local-verified': '本机已验证',
  'runner-bundle-verified': 'Runner 已验证',
  partial: '部分通过',
  'release-signed': 'Release 已签名',
  'verified-release-key': 'Release 签名已验证',
  'unsigned-simulator': '真机待签名',
  'consumer-verified': '独立消费者已验证',
};

const pillTone = (val: string) => {
  if (['passed', 'emulator-verified', 'device-verified', 'desktop-verified', 'local-verified', 'runner-bundle-verified', 'release-signed', 'verified-release-key', 'consumer-verified'].includes(val)) return 'is-ok';
  if (['simulator-verified', 'partial', 'pending', 'unsigned', 'unsigned-simulator', 'blocked'].includes(val)) return 'is-warn';
  return 'is-muted';
};

const totalCount = status.platforms.length;
const buildPassed = status.platforms.filter(p => p.build === 'passed').length;
const runtimeVerified = status.platforms.filter(p => ['passed', 'emulator-verified', 'simulator-verified', 'desktop-verified'].includes(p.runtime)).length;
const signedCount = status.platforms.filter(p => ['verified-release-key', 'release-signed'].includes(p.signing)).length;
---
<Layout title={t("全端进展 · Weapp Container")} description={t("Weapp Container 各宿主平台的构建、安装、运行与签名状态，以及对应的接入文档。")}>
  <section class="section-wrap sp-intro">
    <div class="sp-intro-grid">
      <div>
        <p class="eyebrow"><span class="status-dot"></span><span>{t("全端进展")} · STATUS.JSON</span></p>
        <h1 class="sp-h1">{t("每个端，都有自己的验证。")}</h1>
        <p class="sp-lead">{t("构建、安装和真实运行分别记录。本表展示固定版本的演示证据，当前源码构建需要单独验证。")}</p>
      </div>
      <div class="sp-version-pill">
        <span>{t("更新时间：")}</span>
        <strong>{status.updatedAt}</strong>
      </div>
    </div>

    <div class="pl-kpi-grid">
      <div class="pl-kpi">
        <div class="pl-kpi-k">TARGET PLATFORMS</div>
        <div class="pl-kpi-v">{totalCount}</div>
        <div class="pl-kpi-sub">Web · Android · iOS · HarmonyOS · Desktop</div>
      </div>
      <div class="pl-kpi">
        <div class="pl-kpi-k">BUILD PASSED</div>
        <div class="pl-kpi-v" style="color:var(--accent);">{buildPassed} / {totalCount}</div>
        <div class="pl-kpi-sub">{isEn ? 'Recorded build verification' : '固定版本构建验证通过'}</div>
      </div>
      <div class="pl-kpi">
        <div class="pl-kpi-k">RUNTIME VERIFIED</div>
        <div class="pl-kpi-v">{runtimeVerified} / {totalCount}</div>
        <div class="pl-kpi-sub">Web · Android · iOS · macOS</div>
      </div>
      <div class="pl-kpi">
        <div class="pl-kpi-k">RELEASE SIGNED</div>
        <div class="pl-kpi-v">{signedCount}</div>
        <div class="pl-kpi-sub">Android Release Key</div>
      </div>
    </div>
  </section>

  <section class="section-wrap status-section" style="padding-top:20px;padding-bottom:48px;">
    <div class="pl-toolbar">
      <div class="pl-filters" role="tablist" aria-label={isEn ? 'Filter platforms' : '选择平台状态'} id="pl-filters">
        <button class="pl-filter-btn is-active" type="button" data-filter="all">{isEn ? `All (${totalCount})` : `全部 (${totalCount})`}</button>
        <button class="pl-filter-btn" type="button" data-filter="verified">{isEn ? `Runtime verified (${runtimeVerified})` : `运行已验证 (${runtimeVerified})`}</button>
        <button class="pl-filter-btn" type="button" data-filter="wip">{isEn ? `Partial / Pending (${totalCount - runtimeVerified})` : `部分通过 / 待验证 (${totalCount - runtimeVerified})`}</button>
      </div>
      <span class="muted" style="font-family:var(--font-mono);font-size:11px;">{isEn ? 'Click any row to inspect verification notes' : '点击任意行展开实测说明与证据'}</span>
    </div>

    <div class="pl-ledger-card" id="pl-ledger">
      <div class="pl-row-head">
        <span>{t("运行平台")}</span>
        <span>{t("构建")}</span>
        <span>{t("安装")}</span>
        <span>{t("运行")}</span>
        <span>{t("签名")}</span>
        <span style="text-align:right;">Release</span>
      </div>

      {status.platforms.map((item: any) => {
        const isVerified = ['passed', 'emulator-verified', 'simulator-verified', 'desktop-verified'].includes(item.runtime);
        const tag = isVerified ? 'verified' : 'wip';
        const openByDefault = item.name === 'iOS';
        return (
          <div class={`pl-item${openByDefault ? ' is-open' : ''}`} data-tags={tag}>
            <button class="pl-row-main" type="button" aria-expanded={openByDefault ? 'true' : 'false'}>
              <div class="pl-plat-name">
                <strong>{item.name}</strong>
                <span>{item.architecture}</span>
              </div>
              <span class={`pl-pill ${pillTone(item.build)}`}><i></i>{t(labels[item.build] || item.build)}</span>
              <span class={`pl-pill ${pillTone(item.install)}`}><i></i>{t(labels[item.install] || item.install)}</span>
              <span class={`pl-pill ${pillTone(item.runtime)}`}><i></i>{t(labels[item.runtime] || item.runtime)}</span>
              <span class={`pl-pill ${pillTone(item.signing)}`}><i></i>{t(labels[item.signing] || item.signing)}</span>
              <span class="pl-expand-hint"><span>{item.releaseTag?.split('-').at(-1) || 'details'}</span><span class="pl-caret" aria-hidden="true">▾</span></span>
            </button>
            <div class="pl-drawer" aria-hidden={openByDefault ? 'false' : 'true'}>
              <div class="pl-drawer-inner">
                <div class="pl-drawer-grid">
                  <div>
                    <p class="pl-drawer-note">{item.note ? t(item.note) : (isEn ? 'Recorded in platforms/status.json for the pinned showcase release.' : '记录于固定版本的 platforms/status.json 实测台账。')}</p>
                  </div>
                  <div class="pl-kv-list">
                    {item.releaseTag && <div class="pl-kv-row"><span>releaseTag</span><span>{item.releaseTag}</span></div>}
                    {item.packRoot && <div class="pl-kv-row"><span>packRoot</span><span>{item.packRoot.slice(0, 16)}…{item.packRoot.slice(-7)}</span></div>}
                    {item.sdkBuild && <div class="pl-kv-row"><span>sdkBuild</span><span>{item.sdkBuild}</span></div>}
                    {item.sdkRuntime && <div class="pl-kv-row"><span>sdkRuntime</span><span>{item.sdkRuntime}</span></div>}
                    {item.duoAcceptance && <div class="pl-kv-row"><span>duoAcceptance</span><span>{item.duoAcceptance}</span></div>}
                    {item.sdkEvidence && <div class="pl-kv-row"><span>sdkEvidence</span><a class="text-link" href={item.sdkEvidence} target="_blank" rel="noreferrer" style="font-size:11px;">GitHub Actions ↗</a></div>}
                    {item.runtimeEvidence && <div class="pl-kv-row"><span>runtimeEvidence</span><a class="text-link" href={item.runtimeEvidence} target="_blank" rel="noreferrer" style="font-size:11px;">GitHub Actions ↗</a></div>}
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <p class="muted" style="margin-top:14px;">{t("更新时间：")}{status.updatedAt}{t("。编译通过不代表真机、性能或完整兼容性验收。")}</p>
  </section>

  <section class="section-wrap integration-section" style="padding-bottom:64px;">
    <div class="pb-sec-head" style="margin-bottom:16px;">
      <div>
        <p class="pb-sec-kicker">HOST INTEGRATIONS</p>
        <h2 style="font-size:22px;">{t("选择适合你的接入方式。")}</h2>
      </div>
      <a class="header-pill-btn" href="https://github.com/weapp-container/website/releases" target="_blank" rel="noreferrer">{t("查看受限 Showcase 发行记录 ↗")}</a>
    </div>

    <div class="pl-integ-grid">
      <article class="pl-integ-card">
        <div>
          <h3>{t("原生 SDK")}</h3>
          <p>{t("Android、iOS 和 C++ Desktop 独立接入。")}</p>
        </div>
        <div class="pl-integ-links">
          <a href={href("/docs/integrations/android/")}>Android</a>
          <a href={href("/docs/integrations/ios/")}>iOS</a>
          <a href={href("/docs/integrations/desktop/")}>Desktop</a>
        </div>
      </article>
      <article class="pl-integ-card">
        <div>
          <h3>Flutter</h3>
          <p>{t("Android、iOS、macOS、Windows 与 Linux。")}</p>
        </div>
        <div class="pl-integ-links">
          <a href={href("/docs/integrations/flutter/")}>{t("Flutter 接入文档")}</a>
        </div>
      </article>
      <article class="pl-integ-card">
        <div>
          <h3>React Native</h3>
          <p>{t("Fabric 与 TurboModules，新架构 Android / iOS。")}</p>
        </div>
        <div class="pl-integ-links">
          <a href={href("/docs/integrations/react-native/")}>{t("React Native 接入文档")}</a>
        </div>
      </article>
      <article class="pl-integ-card">
        <div>
          <h3>{t("Web 与 HarmonyOS")}</h3>
          <p>{t("当前为固定在线演示与受限原生示例，不提供通用 Web 或 HarmonyOS SDK。")}</p>
        </div>
        <div class="pl-integ-links">
          <a href={href("/docs/integrations/web/")}>{t("Web 边界")}</a>
          <a href={href("/docs/integrations/harmony/")}>{t("HarmonyOS 状态")}</a>
        </div>
      </article>
    </div>
    <p class="muted" style="margin-top:14px;">{t("历史发行物的访问权限与公开源码许可分别管理。当前运行库请从公开发行物下载。")}</p>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.pl-row-main').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.pl-item');
        if (!item) return;
        const open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        item.querySelector('.pl-drawer')?.setAttribute('aria-hidden', String(!open));
      });
    });

    const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('#pl-filters .pl-filter-btn')];
    const items = [...document.querySelectorAll<HTMLElement>('#pl-ledger .pl-item')];
    filterBtns.forEach(btn => btn.addEventListener('click', () => {
      const k = btn.dataset.filter || 'all';
      filterBtns.forEach(b => b.classList.toggle('is-active', b === btn));
      items.forEach(it => {
        it.hidden = k !== 'all' && it.dataset.tags !== k;
      });
    }));
  </script>
</Layout>
