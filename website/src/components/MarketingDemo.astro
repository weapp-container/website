---
import Layout from '../layouts/Layout.astro';
import {localeFromPath, ui} from '../data/i18n.mjs';
import copy from '../data/marketing-copy.json';
import Demo from '../components/Demo';

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === 'en';
const t = (value: string) => isEn ? copy[value.trim() as keyof typeof copy] || value : value;
---
<Layout title={t("在线体验 · Weapp Container")} description={t("在真实浏览器容器中体验基础能力、商城与点单。无需安装，所有订单均为本地模拟。")}>
  <div class="demo-subbar">
    <div class="demo-subbar-inner">
      <div class="demo-subbar-left">
        <h1 class="demo-subbar-title">{t('在线体验')}</h1>
        <span class="demo-subbar-sep" aria-hidden="true"></span>
        <span class="demo-subbar-meta">Dedicated Worker · QuickJS/WASM + CanvasKit · restricted-showcase</span>
      </div>
      <p class="demo-subbar-note">{ui(locale).demoChinese}</p>
    </div>
  </div>
  <Demo locale={locale} client:load />
</Layout>
