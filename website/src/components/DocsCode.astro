---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import {localeFromPath} from '../data/i18n.mjs';

type Props = Pick<ComponentProps<typeof Code>, 'code' | 'lang'>;
const { code, lang = 'text' } = Astro.props;
const english = localeFromPath(Astro.url.pathname) === 'en';
---
<div class="docs-code-block" data-code-language={lang}>
  <div class="docs-code-toolbar">
    <span>{lang}</span>
    <button class="docs-copy-button" type="button" aria-label={english ? 'Copy code' : '复制代码'} title={english ? 'Copy code' : '复制代码'}>{english ? 'Copy' : '复制'}</button>
  </div>
  <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
</div>
