---
import {getCollection} from 'astro:content';
import Layout from './Layout.astro';
import '../styles/docs.css';
import inventory from '../data/api-inventory-v1.json';
import {apiSlug} from '../data/api-group-meta.mjs';
import {localizedDocsNavigation, localizedDocsPages} from '../data/docs-pages.mjs';
import {localeFromPath, localizedPath, ui} from '../data/i18n.mjs';
const currentPath = Astro.url.pathname;
const locale = localeFromPath(currentPath), text = ui(locale);
const href = (value: string) => localizedPath(value, locale);
const {title = text.docs, description = text.siteDescription} = Astro.props;
const pageByPath = new Map(localizedDocsPages(locale).map(page => [page.path, page]));
const sections = localizedDocsNavigation(locale);
const engineering = (await getCollection('engineering')).filter(page => page.data.locale === locale);
const engineeringSections = [...new Set(engineering.map(page => page.data.section))].sort();
const apiGroups = inventory.apis.map(api => ({...api, href: href(`/docs/api/${apiSlug(api.id)}/`)}));
---
<Layout title={`${title} · Weapp Container`} description={description}>
  <div class="docs-mobile-nav"><details><summary>{text.docsNav}</summary><div class="docs-mobile-nav-body">
    <label class="docs-search-label" for="docs-search-mobile">{text.search}</label>
    <input id="docs-search-mobile" class="docs-search" type="search" placeholder={text.search} autocomplete="off" aria-controls="docs-search-results-mobile" aria-expanded="false" />
    <div id="docs-search-results-mobile" class="docs-search-results" role="listbox" aria-label={text.searchResults} hidden></div>
    {sections.map(section => <section class="docs-nav-section"><h2>{section.title}</h2><ul>{section.paths.map(path => {const page = pageByPath.get(path); return page && <li><a href={page.path} aria-current={currentPath === page.path ? 'page' : undefined}>{page.title}</a></li>;})}</ul></section>)}
    <details class="docs-nav-section"><summary>{text.apiGroups}</summary><ul>{apiGroups.map(api => <li><a href={api.href}>{api.id}</a></li>)}</ul></details>
    <details class="docs-nav-section"><summary>{text.engineering}</summary>{engineeringSections.map(section => <details><summary>{section}</summary><ul>{engineering.filter(page => page.data.section === section).map(page => <li><a href={href(page.data.route)}>{page.data.title}</a></li>)}</ul></details>)}</details>
  </div></details></div>
  <div class="docs-frame">
    <aside class="docs-sidebar" aria-label={text.docsNav}>
      <a class="docs-home-link" href={href('/docs/')}>{text.docs}<span>Weapp Container</span></a>
      <label class="docs-search-label" for="docs-search">{text.search}</label>
      <input id="docs-search" class="docs-search" type="search" placeholder={text.search} autocomplete="off" aria-controls="docs-search-results" aria-expanded="false" />
      <div id="docs-search-results" class="docs-search-results" role="listbox" aria-label={text.searchResults} hidden></div>
      {sections.map(section => <section class="docs-nav-section"><h2>{section.title}</h2><ul>{section.paths.map(path => {const page = pageByPath.get(path); return page && <li><a href={page.path} aria-current={currentPath === page.path ? 'page' : undefined}>{page.title}</a></li>;})}</ul></section>)}
      <details class="docs-nav-section docs-api-nav" open={currentPath.includes('/docs/api/')}><summary>{text.apiGroups}</summary><ul>{apiGroups.map(api => <li><a href={api.href} aria-current={currentPath === api.href ? 'page' : undefined}>{api.id}</a></li>)}</ul></details>
      <details class="docs-nav-section docs-engineering-nav" open={currentPath.includes('/docs/engineering/')}><summary>{text.engineering}</summary>
        {engineeringSections.map(section => <details open={engineering.some(page => page.data.section === section && href(page.data.route) === currentPath)}><summary>{section}</summary><ul>{engineering.filter(page => page.data.section === section).map(page => <li><a href={href(page.data.route)} aria-current={href(page.data.route) === currentPath ? 'page' : undefined}>{page.data.title}</a></li>)}</ul></details>)}
      </details>
    </aside>
    <div class="docs-main-column">
      <nav class="docs-breadcrumbs" aria-label={locale === 'en' ? 'Breadcrumbs' : '面包屑导航'}><a href={href('/docs/')}>{text.docs}</a><span aria-hidden="true">/</span><span>{title}</span></nav>
      <article id="docs-content" class="docs-article"><slot /></article>
      <nav id="docs-page-outline" class="docs-page-outline" aria-label={text.toc} hidden><strong>{text.toc}</strong><ul></ul></nav>
      <footer class="docs-article-footer"><a href={href('/docs/troubleshooting/')}>{text.troubleshooting}</a><a href="https://github.com/weapp-container/sdk-contract" target="_blank" rel="noreferrer">{text.contract} ↗</a></footer>
    </div>
  </div>
</Layout>
<script define:vars={{text, searchUrl: href('/docs/search-index.json')}}>
  const inputs = [...document.querySelectorAll('.docs-search')];
  const resultLists = [...document.querySelectorAll('.docs-search-results')];
  let searchIndex = [], searchError = false;
  const searchReady = fetch(searchUrl).then(response => {
    if (!response.ok) throw new Error('Search index unavailable');
    return response.json();
  }).then(index => { if (!Array.isArray(index)) throw new Error('Invalid search index'); searchIndex = index; }).catch(() => { searchError = true; });
  const normalize = value => value.normalize('NFKC').toLocaleLowerCase();
  function status(results, value) {results.replaceChildren(); const message = document.createElement('p'); message.className = 'docs-search-empty'; message.setAttribute('role', 'status'); message.textContent = value; results.append(message); results.hidden = false; inputs[resultLists.indexOf(results)]?.setAttribute('aria-expanded', 'true');}
  function renderResults(input, results) {
    const query = normalize(input.value.trim()); results.replaceChildren();
    if (!query) {results.hidden = true; input.setAttribute('aria-expanded', 'false'); return;}
    if (searchError) {status(results, text.searchError); return;}
    const tokens = query.split(/\s+/).filter(Boolean);
    const matches = searchIndex.map(item => {
      const haystack = normalize(`${item.title} ${item.summary} ${item.keywords} ${item.body || ''}`);
      return {item, score: tokens.reduce((score, token) => score + (normalize(item.title).includes(token) ? 5 : normalize(item.keywords).includes(token) ? 3 : haystack.includes(token) ? 1 : -100), 0)};
    }).filter(match => match.score >= tokens.length).sort((a, b) => b.score - a.score).slice(0, 10);
    if (!matches.length) {status(results, text.empty); return;}
    for (const {item} of matches) {
      const link = document.createElement('a'); link.href = item.path; link.setAttribute('role', 'option');
      const heading = document.createElement('strong'); heading.textContent = item.title;
      const summary = document.createElement('span'); summary.textContent = item.summary;
      link.append(heading, summary); results.append(link);
    }
    results.hidden = false; input.setAttribute('aria-expanded', 'true');
  }
  inputs.forEach((input, index) => {
    const results = resultLists[index];
    input.addEventListener('input', async () => {if (input.value.trim()) status(results, text.searchLoading); await searchReady; renderResults(input, results);});
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') {results.hidden = true; input.setAttribute('aria-expanded', 'false'); input.blur();}
      if (event.key === 'Enter') {const first = results.querySelector('a'); if (first) location.assign(first.href);}
      if (event.key === 'ArrowDown') {event.preventDefault(); results.querySelector('a')?.focus();}
    });
    results.addEventListener('keydown', event => {
      const links = [...results.querySelectorAll('a')], current = links.indexOf(document.activeElement);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {event.preventDefault(); links[(current + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length]?.focus();}
      if (event.key === 'Escape') {results.hidden = true; input.setAttribute('aria-expanded', 'false'); input.focus();}
    });
  });
  document.addEventListener('keydown', event => {if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {event.preventDefault(); inputs.find(input => input.offsetParent !== null)?.focus();}});
  const outline = document.querySelector('#docs-page-outline'), outlineList = outline?.querySelector('ul');
  for (const heading of document.querySelectorAll('#docs-content h2[id], #docs-content h3[id]')) {
    const item = document.createElement('li'); if (heading.tagName === 'H3') item.className = 'docs-toc-nested';
    const link = document.createElement('a'); link.href = `#${heading.id}`; link.textContent = heading.textContent; item.append(link); outlineList?.append(item);
  }
  if (outlineList?.childElementCount) outline.hidden = false;
  document.querySelectorAll('#docs-content .docs-code-block').forEach(wrapper => {
    const pre = wrapper.querySelector('pre'), button = wrapper.querySelector('button'); if (!pre || !button) return;
    button.textContent = text.copy; button.setAttribute('aria-label', text.copy);
    button.addEventListener('click', async () => {
      try {await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || pre.textContent || ''); button.textContent = text.copied;}
      catch {button.textContent = text.copyError;}
      window.setTimeout(() => {button.textContent = text.copy;}, 1200);
    });
  });
</script>
